<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org">
<!-- This checkstyle file is written to adhere to the CS 314 Hygiene Guide found here: -->
<!-- https://www.cs.utexas.edu/~scottm/cs314/handouts/hygiene_guide/code_hygiene_guide_framed.html -->

<!-- Certain Formatting rules can instead be found in format_spec/java.xml -->

<module name="Checker">
    <module name="TreeWalker">
        <!-- 1.3.2 Magic Numbers -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
        </module>

        <!-- 1.3.3. Limit methods to 25 lines of code -->
        <module name="MethodLength">
            <property name="max" value="25"/>
        </module>

        <!-- 1.3.5. Use descriptive identifiers -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{2,}$"/>
            <property name="allowOneCharVarInForLoop" value="true"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{2,}$"/>
        </module>

        <!-- 2.1 Package Statements -->
        <module name="IllegalToken">
            <property name="tokens" value="PACKAGE_DEF"/>
        </module>

        <!-- 2.2 Import Statements -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport">
            <property name="regexp" value="true"/>
            <property name="illegalClasses" value="^(?!(java\.|javax\.)).+$"/>
        </module>

        <!-- 2.3 Ordering of Class components -->
        <module name="DeclarationOrder"/>

        <!-- 3.2 Spacing -->
        <module name="WhitespaceAround">
            <property name="tokens" value="PLUS, MINUS, STAR, DIV, MOD, EQUAL, NOT_EQUAL, GT, GE, LT, LE, LAND, LOR, BAND, BOR, BXOR"/>
        </module>

        <!-- 3.3 One statement per line -->
        <module name="OneStatementPerLine"/>

        <!-- 3.7 Enclose all blocks with curly braces -->
        <module name="NeedBraces"/>

        <!-- 5.4 Constructors -->
        <module name="RequireThis">
            <property name="checkFields" value="true"/>
            <property name="checkMethods" value="true"/>
        </module>

        <!-- 6.1 Casing -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- 9.1 Boolean Zen -->
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/> 

        <!-- 10.1 Avoid the use of break and continue, especially on assignments -->
        <module name="IllegalToken">
            <property name="tokens" value="LITERAL_BREAK, LITERAL_CONTINUE"/>
        </module>

        <!-- 10.2 Do not return from void method -->
        <module name="ReturnCount">
            <property name="maxForVoid" value="0"/>
            <property name="max" value="30"/>
        </module>

        <!-- 10.5 Do not use try / catch blocks to deal with avoidable logic errors. -->
        <module name="IllegalToken">
            <property name="tokens" value="LITERAL_TRY, LITERAL_CATCH"/>
        </module>
    </module>
</module>